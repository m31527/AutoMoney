# Python CLI: export values in your shell; it does not automatically load .env.
# Docker Compose: automatically reads .env; mode and DB are fixed in compose.yaml.
TRADING_MODE=TESTNET
ENABLE_LIVE_TRADING=false
DATABASE_URL=sqlite:///data/trading.db
# For local simulated execution, explicitly set TRADING_MODE=PAPER and use a separate DB:
# DATABASE_URL=sqlite:///data/paper.db
# python -m trader paper-init
# python -m trader paper-run --strategy hold --cycles 1
# Only the account command reads Binance credentials. Use Spot Testnet HMAC keys only.
# Public market queries do not need credentials. Never paste credentials into CLI arguments.
BINANCE_API_KEY=
BINANCE_API_SECRET=
AI_PROVIDER=
# Set AI_PROVIDER=openai and an explicitly chosen Responses structured-output model.
# Used only with paper-run --strategy ai. No model or provider is selected automatically.
AI_MODEL=
AI_API_KEY=

# Legacy paper-start only; comparison mode ignores strategy/symbol:
PAPER_STRATEGY=sma
PAPER_SYMBOL=BTCUSDT
# Both comparison and legacy mode; 0 means continuous:
PAPER_CYCLES=0

# Optional native Ollama provider (no API key).
# AI_PROVIDER=ollama
# AI_MODEL=qwen3.8:27b
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_TIMEOUT_SECONDS=120
# DGX Spark: use bash scripts/spark.sh setup; see SPARK_START.md.
